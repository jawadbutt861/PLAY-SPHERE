rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users — any logged-in user can read (for payment info, manager details)
    // Only own document can be written
    match /users/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;

      match /favourites/{groundId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Grounds — any logged-in user can read, manager can create/update/delete own
    match /grounds/{groundId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null
        && request.auth.uid == resource.data.managerId;
    }

    // Bookings — any logged-in user can read/create
    match /bookings/{bookingId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null
        && (resource.data.userId == request.auth.uid
            || resource.data.managerId == request.auth.uid
            || resource.data.tournamentCreatorId == request.auth.uid);
      allow delete: if request.auth != null
        && (resource.data.userId == request.auth.uid
            || resource.data.managerId == request.auth.uid);

      match /chat/{msgId} {
        allow read, write: if request.auth != null;
      }
    }

    // Chats — userId_managerId pair ka shared chat thread
    match /chats/{chatId} {
      allow read, write: if request.auth != null;

      match /messages/{msgId} {
        allow read, write: if request.auth != null;
      }
    }

    // Notifications — any logged-in user can read/write
    match /notifications/{notifId} {
      allow read, write: if request.auth != null;
    }

    // Tournaments
    match /tournaments/{tournamentId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null
        && request.auth.uid == resource.data.createdBy;
      allow delete: if request.auth != null
        && request.auth.uid == resource.data.createdBy;

      match /announcements/{msgId} {
        allow read, write: if request.auth != null;
      }
    }

    match /_test/{doc} {
      allow read, write: if request.auth != null;
    }
  }
}
